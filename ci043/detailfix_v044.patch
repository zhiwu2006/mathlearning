+@Composable
+private fun QualityStatusRow(label: String, value: String, positive: Boolean = false) {
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(vertical = 3.dp),
+        horizontalArrangement = Arrangement.SpaceBetween,
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        Text(
+            label,
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant
+        )
+        Surface(
+            shape = RoundedCornerShape(999.dp),
+            color = if (positive) MaterialTheme.colorScheme.primaryContainer
+            else MaterialTheme.colorScheme.surfaceVariant
+        ) {
+            Text(
+                value,
+                modifier = Modifier.padding(horizontal = 10.dp, vertical = 5.dp),
+                style = MaterialTheme.typography.labelMedium,
+                color = if (positive) MaterialTheme.colorScheme.onPrimaryContainer
+                else MaterialTheme.colorScheme.onSurfaceVariant
+            )
+        }
+    }
+}
+
+private fun tierLabel(value: String): String = when (value) {
+    "tutor" -> "Tutor Ready"
+    "gold" -> "Gold 已标注"
+    "structured" -> "来源题 / 待完善"
+    else -> value.ifBlank { "未记录" }
+}
+
+private fun reviewLabel(value: String): String = when {
+    value.startsWith("tutor_verified") -> "Tutor 已审核"
+    value.startsWith("gold_labeled") -> "Gold 标注完成"
+    value == "source_answer_linked" -> "已关联来源答案"
+    value == "source_only" -> "仅来源数据"
+    else -> value.ifBlank { "未记录" }
+}
+
+private fun graphLabel(value: String): String = when (value) {
+    "handcrafted_verified" -> "人工验证完成"
+    "human_verified" -> "人工验证完成"
+    "none", "" -> "尚未构建/审核"
+    else -> value
+}
+
+private fun answerLabel(value: String): String = when (value) {
+    "independently_checked" -> "已独立核验"
+    "math_checked_handcrafted" -> "已人工数学核验"
+    "source_only" -> "仅来源答案"
+    "" -> "未记录"
+    else -> value
+}
+
+private fun visualLabel(value: String): String = when (value) {
+    "verified_problem_visual" -> "题干图已确认"
+    "verified_optional_problem_visual" -> "辅助题图已确认"
+    "verified_no_problem_visual" -> "确认无需题图"
+    "verified_solution_visual" -> "解答图，不展示"
+    "required_candidate" -> "疑似必需图，待审核"
+    "linked_unreviewed" -> "已关联，待语义审核"
+    "none", "" -> "无题图记录"
+    else -> value
+}
+
+private fun taskGoalLabel(value: String): String = when (value) {
+    "compute" -> "计算"
+    "count" -> "计数"
+    "compare" -> "比较"
+    "find_all" -> "找出全部"
+    "classify" -> "分类"
+    "construct" -> "构造"
+    "prove_existence" -> "证明存在"
+    "prove_impossibility" -> "证明不存在"
+    "refute_claim" -> "反驳命题"
+    "optimize_min" -> "求最小值"
+    "optimize_max" -> "求最大值"
+    "find_strategy" -> "寻找策略"
+    "discover_pattern" -> "发现规律"
+    else -> value.ifBlank { "未标注" }
+}
+
+@Composable
+private fun SourceSolutionBlock(raw: String) {
+    val paragraphs = remember(raw) {
+        formatSourceSolution(raw)
+            .split(Regex("\n{2,}"))
+            .map { it.trim() }
+            .filter { it.isNotBlank() }
+    }
+    Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
+        paragraphs.forEach { paragraph ->
+            val heading = paragraph in setOf("分析", "分析与解", "解", "评注", "提示", "说明", "【原书插图】")
+            Text(
+                text = paragraph,
+                style = if (heading) MaterialTheme.typography.titleSmall
+                else MaterialTheme.typography.bodyMedium.copy(lineHeight = 24.sp),
+                fontWeight = if (heading) FontWeight.Bold else FontWeight.Normal,
+                color = if (paragraph == "【原书插图】") MaterialTheme.colorScheme.onSurfaceVariant
+                else MaterialTheme.colorScheme.onSurface
+            )
+        }
+    }
+}
+
+private fun formatSourceSolution(raw: String): String {
+    var text = raw
+        .replace("\r\n", "\n")
+        .replace('\r', '\n')
+        .replace('\u00A0', ' ')
+        .trim()
+
+    text = text.replace(Regex("\\s*\\[IMAGE\\]\\s*"), "\n\n【原书插图】\n\n")
+    text = text.replace(Regex("\\s*---+\\s*"), "\n\n")
+
+    // OCR/MD 生成运行时包时部分段落换行被压平，这里只恢复高置信结构边界。
+    val headingRegex = Regex("(^|[。；;.!?]\\s*)(分析与解|分析|解|评\\s*注|提示|说明)\\s+")
+    text = headingRegex.replace(text) { m ->
+        val prefix = m.groupValues[1]
+        val heading = m.groupValues[2].replace(Regex("\\s+"), "")
+        prefix + "\n\n" + heading + "\n"
+    }
+    text = text.replace(Regex("\\s+(（[0-9一二三四五六七八九十]+）)\\s*"), "\n$1 ")
+    text = text.replace(Regex("[ \\t]+\\n"), "\n")
+    text = text.replace(Regex("\\n[ \\t]+"), "\n")
+    text = text.replace(Regex("\\n{3,}"), "\n\n")
+    return text.trim()
 }
 
