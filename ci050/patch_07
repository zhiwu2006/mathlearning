+                                            repository.recordComprehensionAttempt(question, score, evidence)
+                                            onFinished(score)
+                                        }
+                                    } else index++
+                                } else {
+                                    submitCounts[index] = (submitCounts[index] ?: 0) + 1
+                                    val hasSelection = if (node.type == "multi_choice") selectedMulti.isNotEmpty() else selected != null
+                                    if (!hasSelection) {
+                                        feedback = "先选择你的答案。"
+                                    } else {
+                                        val ok = evaluateComprehensionNode(node.type, payload, selected, selectedMulti.toSet())
+                                        if (ok) {
+                                            correct = true
+                                            feedback = node.feedback.ifBlank { "正确，可以进入下一步。" }
+                                        } else {
+                                            if (index !in wrongNodes) wrongNodes.add(index)
+                                            feedback = "这一层理解还不准确。先不要计算，重新回到题目文字找证据。"
+                                        }
+                                    }
+                                }
+                            },
+                            modifier = Modifier.fillMaxWidth()
+                        ) { Text(if (correct) if (index == nodes.lastIndex) "完成读题" else "下一步" else "确认这一步") }
+
+                        if (!correct) {
+                            Spacer(Modifier.height(8.dp))
+                            OutlinedButton(
+                                onClick = {
+                                    hintVisible = true
+                                    if (index !in hintNodes) hintNodes.add(index)
+                                },
+                                modifier = Modifier.fillMaxWidth()
+                            ) { Text("给我一个提示") }
+                        }
+                    }
+                }
+            }
+        }
+    }
