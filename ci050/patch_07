+                        feedback?.let {
+                            Spacer(Modifier.height(10.dp))
+                            Surface(
+                                color = if (correct) MaterialTheme.colorScheme.primaryContainer else MaterialTheme.colorScheme.errorContainer,
+                                shape = RoundedCornerShape(13.dp)
+                            ) { Text(it, modifier = Modifier.padding(12.dp)) }
+                        }
+                        if (hintVisible && node.hint.isNotBlank()) {
+                            Spacer(Modifier.height(10.dp))
+                            Surface(color = MaterialTheme.colorScheme.tertiaryContainer, shape = RoundedCornerShape(13.dp)) {
+                                Text("提示：${node.hint}", modifier = Modifier.padding(12.dp))
+                            }
+                        }
+
+                        Spacer(Modifier.height(14.dp))
+                        Button(
+                            onClick = {
+                                if (correct) {
+                                    if (index == nodes.lastIndex) {
+                                        val evidence = nodes.mapIndexed { i, n ->
+                                            ComprehensionNodeEvidence(
