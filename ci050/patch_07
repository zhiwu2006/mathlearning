+                                                skill = n.skill,
+                                                firstTryCorrect = i !in wrongNodes,
+                                                hintUsed = i in hintNodes,
+                                                attempts = submitCounts[i] ?: 1,
+                                            )
+                                        }
+                                        val score = evidence.map { readingEvidenceScore(it.firstTryCorrect, it.hintUsed) }.average().roundToInt()
