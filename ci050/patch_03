+private fun pickReadingSmart(
+    questions: List<QuestionEntity>,
+    attempts: List<ComprehensionAttemptEntity>,
+): QuestionEntity? {
+    if (questions.isEmpty()) return null
+    val counts = attempts.groupingBy { it.questionId }.eachCount()
+    return questions.minWithOrNull(compareBy<QuestionEntity> { counts[it.id] ?: 0 }.thenBy { it.id })
+}
