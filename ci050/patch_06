+private fun evaluateComprehensionNode(
+    type: String,
+    payload: JSONObject,
+    selected: Int?,
+    selectedMulti: Set<Int>,
+): Boolean = when (type) {
+    "choice" -> selected != null && selected == payload.optInt("correctIndex", -1)
+    "multi_choice" -> {
+        val arr = payload.optJSONArray("correctIndices") ?: JSONArray()
+        val correct = buildSet { for (i in 0 until arr.length()) add(arr.getInt(i)) }
+        selectedMulti == correct
+    }
+    else -> false
+}
