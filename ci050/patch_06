+private fun formatSourceSolution(raw: String): String {
+    var text = raw.replace("\r\n", "\n").replace('\r', '\n').replace('\u00A0', ' ').trim()
+    text = text.replace(Regex("\\s*\\[IMAGE\\]\\s*"), "\n\n【原书插图】\n\n")
+    text = text.replace(Regex("\\s*---+\\s*"), "\n\n")
+    val headingRegex = Regex("(^|[。；;.!?]\\s*)(分析与解|分析|解|评\\s*注|提示|说明)\\s+")
+    text = headingRegex.replace(text) { m -> m.groupValues[1] + "\n\n" + m.groupValues[2].replace(Regex("\\s+"), "") + "\n" }
+    text = text.replace(Regex("\\s+(（[0-9一二三四五六七八九十]+）)\\s*"), "\n$1 ")
+    text = text.replace(Regex("[ \\t]+\\n"), "\n").replace(Regex("\\n[ \\t]+"), "\n").replace(Regex("\\n{3,}"), "\n\n")
+    return text.trim()
+}
